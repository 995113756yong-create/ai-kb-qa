OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
AGENT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
AGENT_MAX_STEPS=6
AGENT_SEARCH_K=5
HYBRID_SEARCH_ENABLED=true
RRF_K=60
HYBRID_VECTOR_WEIGHT=1.0
HYBRID_BM25_WEIGHT=3.0
QUERY_DECOMPOSE_ENABLED=false
RERANK_ENABLED=false
AGENTS_DIR=backend/agents_store

# ============ 可信回答与评测体系 ============
# 证据门槛：余弦相似度低于该值且未命中编号关键词的片段不登记为证据（真实 Embedding 校准：正例保留 95.8% / 负例拦截 95.8%）
EVIDENCE_MIN_SIM=0.46
# 默认专家的回答模式：strict 只答知识库 / reference 知识库优先+通用知识兜底
DEFAULT_AGENT_ANSWER_MODE=strict
# 管理员口令：设置后建/删专家、上传、删文档需要 X-Admin-Token 头（生产环境必须设置）
ADMIN_TOKEN=
# 问答限流：每客户端每分钟最多请求数，0 关闭
RATE_LIMIT_PER_MIN=10
# 是否信任 X-Forwarded-For（经 Next.js 转发部署必须设为 true）
TRUST_PROXY=false
# 流式回答是否请求 usage 统计（模型服务不支持 stream_options 时设为 false）
LLM_STREAM_USAGE=true
# LLM-as-judge 评判模型（建议与生成模型不同，减少自我偏好）
JUDGE_MODEL=
JUDGE_API_BASE=
JUDGE_API_KEY=
# 评测费用估算（元/百万 token），用于报告；不配显示"未配置"
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=

# 规则意图分流（闲聊直接回复 / 列文档直接调工具 / 编号类问题先预检索），默认开启
INTENT_ROUTING_ENABLED=true

# 模型调用超时（秒）。流式回答是两个 chunk 之间的读超时，不是整段总时长
LLM_TIMEOUT_SECONDS=60
# 模型调用失败重试次数上限
LLM_MAX_RETRIES=1
# Embedding 调用超时（秒）
EMBEDDING_TIMEOUT_SECONDS=30

# 反馈文件大小上限（MB），超过后轮转为 feedback.jsonl.1
FEEDBACK_MAX_MB=5

# 多轮追问改写：有历史且问题像追问时，先改写成可独立检索的问题
CONTEXTUALIZE_ENABLED=true
# 送进改写 prompt 的历史轮数上限（一问一答算一轮）
CONTEXTUALIZE_MAX_TURNS=3
