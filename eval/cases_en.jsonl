# English cases for the fitness-coach expert.
# Mirrors the 13 fitness cases in cases.jsonl (ids ft1-ft5, fc1, fm1, fd1, fx1, fp1, fr1-fr3).
{"id": "ft1", "category": "fact", "agent": "fitness-coach", "lang": "en", "question": "How many times per week should a beginner train?", "expect_keywords": ["3"], "expect_sources": ["Beginner Training Plan.txt"], "note": "basic fact"}
{"id": "ft2", "category": "fact", "agent": "fitness-coach", "lang": "en", "question": "How much protein per kilogram of body weight per day do strength trainees need?", "expect_keywords": ["1.6", "2.2"], "expect_sources": ["Nutrition Basics.txt"], "note": "protein range"}
{"id": "ft3", "category": "fact", "agent": "fitness-coach", "lang": "en", "question": "What percentage of maximum heart rate should an easy run stay at?", "expect_keywords": ["60", "70"], "expect_sources": ["Running Basics.txt"], "note": "easy run HR zone"}
{"id": "ft4", "category": "fact", "agent": "fitness-coach", "lang": "en", "question": "How many seconds should a beginner start a plank at?", "expect_keywords": ["20"], "expect_sources": ["Exercise Library.txt", "Beginner Training Plan.txt"], "note": "plank starting duration"}
{"id": "ft5", "category": "fact", "agent": "fitness-coach", "lang": "en", "question": "How many hours should I sleep for muscle recovery?", "expect_keywords": ["7", "9"], "expect_sources": ["Beginner Training Plan.txt"], "note": "sleep duration"}
{"id": "fc1", "category": "compare", "agent": "fitness-coach", "lang": "en", "question": "How many reps per set for a beginner strength exercise, and how long is the brisk walk in the first two weeks of running?", "expect_keywords": ["8", "12", "30"], "expect_min_sources": 2, "note": "two documents compared"}
{"id": "fm1", "category": "multi_hop", "agent": "fitness-coach", "lang": "en", "question": "I weigh 70 kg. Roughly how many grams of protein per day does the knowledge base recommend?", "expect_keywords": ["112", "154"], "expect_sources": ["Nutrition Basics.txt"], "note": "requires computing from the 1.6-2.2 g/kg rule"}
{"id": "fd1", "category": "derived", "agent": "fitness-coach", "lang": "en", "question": "I am 30 years old. Roughly what heart rate range should an easy run be in?", "expect_keywords": ["220", "133"], "expect_sources": ["Running Basics.txt"], "note": "max HR estimate then 60-70% window", "allow_numeric_warnings": true}
{"id": "fx1", "category": "mixed", "agent": "fitness-coach", "lang": "en", "question": "How much protein should I eat per day while building muscle? Also, what does creatine do?", "expect_keywords": ["1.6", "2.2"], "expect_sources": ["Nutrition Basics.txt"], "note": "kb part + general knowledge part (creatine not in kb)"}
{"id": "fp1", "category": "persona", "agent": "fitness-coach", "lang": "en", "question": "My knee hurts when I run. Should I keep training through it?", "expect_answer": "doctor", "note": "persona must advise seeing a doctor"}
{"id": "fr1", "category": "reject", "agent": "fitness-coach", "lang": "en", "question": "How exactly do you do a sun salutation in yoga?", "expect_no_sources": true, "note": "not in knowledge base"}
{"id": "fr2", "category": "reject", "agent": "fitness-coach", "lang": "en", "question": "Is the body fat percentage from a smart scale accurate?", "expect_no_sources": true, "note": "not in knowledge base"}
{"id": "fr3", "category": "reject", "agent": "fitness-coach", "lang": "en", "question": "What are some breathing techniques for swimming?", "expect_no_sources": true, "note": "not in knowledge base"}
